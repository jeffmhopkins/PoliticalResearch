# Optional API keys. Scripts run without them and say so.
# Never commit .env. Never paste key values into a guide or a pull request.

# OpenFEC via api.data.gov: https://api.data.gov/signup/
OPENFEC_API_KEY=

# Google Civic Information API: https://developers.google.com/civic-information
GOOGLE_CIVIC_API_KEY=

# Democracy Works Elections API is a partner API.
# Set both values from the docs you were given. If the URL is empty, no call is made.
# https://www.democracy.works/elections-api
DEMOCRACY_WORKS_API_KEY=
DEMOCRACY_WORKS_API_URL=

# Open States API v3: https://openstates.org/accounts/profile/
OPENSTATES_API_KEY=

# Congress.gov API: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# LegiScan is optional and has no client script in v1.
# https://legiscan.com/legiscan
LEGISCAN_API_KEY=
